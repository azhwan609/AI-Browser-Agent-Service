# Existing model configuration
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# Identity Vault configuration
# Generate once with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
IDENTITY_VAULT_KEY=
# Use a persistent mounted disk in production, not the ephemeral container filesystem.
IDENTITY_VAULT_DIR=/var/data/identity-vault
# Long random secret for the protected profile-management API.
PROFILE_ADMIN_KEY=
